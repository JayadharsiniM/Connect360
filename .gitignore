# =============================================================================
# Connect360 - Git Ignore
# =============================================================================

# Dependencies
node_modules/

# Build outputs
frontend/dist/
frontend/.next/
infra/lambda_packages/
*.zip

# Environment & secrets (NEVER commit real credentials)
.env
.env.local
.env.*.local

# Terraform state & providers (contains sensitive data)
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.backup
infra/.terraform.lock.hcl
infra/crash.log

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/

# Logs
*.log
npm-debug.log*

# Coverage & testing
coverage/
.nyc_output/
